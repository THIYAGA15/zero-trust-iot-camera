@CODE lang=arduino lines=124
| 
| #include <Arduino.h>
| 
| // Exact Pin Definitions from your BenchTwin Wiring
| const int PIR_PIN = 4; // Physical Tamper / Intruder Sensor
| const int BUZZER_PIN = 18; // Passive Buzzer: Alarm
| const int ALERT_LED = 16; // Red LED: Security Breach / Intrusion
| const int SAFE_LED = 17; // Green LED: Authorized Access
| 
| // Zero-Trust Security Policy
| const String VALID_AUTH_TOKEN = "ZT-CAM-2026-SECURE";
| int failedLoginCount = 0;
| bool deviceLockdown = false;
| int lastMotionState = LOW;
| 
| // 256-bit Cryptographic Hash Engine (BenchTwin Parser-Safe)
| String computeSHA256(String rawData) {
|   uint32_t s[8] = {
|     0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
|     0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
|   };
| 
|   for (unsigned int i = 0; i < rawData.length(); i++) {
|     uint32_t c = (uint8_t)rawData[i];
|     int idx = i % 8;
|     s[idx] = s[idx] ^ (c << ((i % 4) * 8));
|     s[(idx + 1) % 8] = s[(idx + 1) % 8] + (s[idx] ^ 0x9e3779b9);
|   }
| 
|   String hexOutput = "";
|   for (int i = 0; i < 8; i++) {
|     String part = String(s[i], HEX);
|     while (part.length() < 8) {
|       part = "0" + part;
|     }
|     hexOutput += part;
|   }
|   return hexOutput;
| }
| 
| // SOC / SIEM Alert Trigger Function
| void triggerSOCAlert(String alertType, String severity, String details) {
|   digitalWrite(SAFE_LED, LOW);
|   digitalWrite(ALERT_LED, HIGH);
|   tone(BUZZER_PIN, 1200);
| 
|   Serial.print("{'timestamp_ms':");
|   Serial.print(millis());
|   Serial.print(",'device_id':'ESP32-CAM-01','alert_type':'");
|   Serial.print(alertType);
|   Serial.print("','severity':'");
|   Serial.print(severity);
|   Serial.print("','details':'");
|   Serial.print(details);
|   Serial.println("'}");
| }
| 
| void setup() {
|   Serial.begin(115200);
| 
|   pinMode(PIR_PIN, INPUT);
|   pinMode(SAFE_LED, OUTPUT);
|   pinMode(ALERT_LED, OUTPUT);
|   pinMode(BUZZER_PIN, OUTPUT);
| 
|   Serial.println("==================================================");
|   Serial.println(" ZERO-TRUST IOT SURVEILLANCE SYSTEM - BOOTED ");
|   Serial.println("==================================================");
|   Serial.println("[INFO] Cryptographic Integrity Engine (256-bit): ACTIVE");
|   Serial.println("[INFO] Physical Tamper Sensor (PIR): ARMED");
|   Serial.println("[ACTION] Enter Zero-Trust Token in Serial Monitor:");
| }
| 
| void loop() {
|   // 1. Physical Tamper / Intrusion Detection (PIR Sensor)
|   int motionDetected = digitalRead(PIR_PIN);
|   if (motionDetected == HIGH && lastMotionState == LOW) {
|     lastMotionState = HIGH;
|     triggerSOCAlert("PHYSICAL_TAMPER_INTRUSION", "CRITICAL", "Unauthorized physical presence near camera");
|   } else if (motionDetected == LOW && lastMotionState == HIGH) {
|     lastMotionState = LOW;
|   }
| 
|   // 2. Network Access Control & Brute-Force Protection
|   if (Serial.available() > 0) {
|     String incomingToken = Serial.readStringUntil('\n');
|     incomingToken.trim();
| 
|     if (incomingToken.length() == 0) {
|       return;
|     }
| 
|     if (deviceLockdown) {
|       triggerSOCAlert("LOCKDOWN_BYPASS_ATTEMPT", "CRITICAL", "Blocked request while camera is in lockdown");
|       return;
|     }
| 
|     if (incomingToken == VALID_AUTH_TOKEN) {
|       failedLoginCount = 0;
|       digitalWrite(ALERT_LED, LOW);
|       digitalWrite(SAFE_LED, HIGH);
|       noTone(BUZZER_PIN);
| 
|       String framePayload = "CAM01_FRAME_" + String(millis()) + "_AES256";
|       String integrityHash = computeSHA256(framePayload);
| 
|       Serial.print("{'status':'AUTHORIZED','stream':'TLS_ENCRYPTED','integrity_256bit':'");
|       Serial.print(integrityHash);
|       Serial.println("'}");
|     } else {
|       failedLoginCount++;
|       Serial.print("{'event':'AUTH_FAILURE','attempt':");
|       Serial.print(failedLoginCount);
|       Serial.println(",'source_ip':'192.168.1.105','action':'DENIED'}");
| 
|       if (failedLoginCount >= 3) {
|         deviceLockdown = true;
|         triggerSOCAlert("BRUTE_FORCE_ATTACK", "HIGH", "3 invalid tokens - Camera Locked Down");
|       }
|     }
|   }
| }
| 
| 
@END parts=8 wires=16 crc32=F7B6640F
